############################
# Stage 0: Fields2Cover build
############################
# Keep the known-good GDAL/GEOS toolchain for building Fields2Cover.
FROM osgeo/gdal:ubuntu-full-3.6.3 AS fields2cover_builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspaces

# Match the original Dockerfile's GDAL include layout workaround so that
# headers like gdal/ogr_geometry.h are found during the Fields2Cover build.
RUN mkdir -p /usr/include/new_gdal && \
    cp -r /usr/include/gdal* /usr/include/new_gdal/ || true && \
    cp /usr/include/ogr* /usr/include/new_gdal/ || true && \
    cp /usr/include/cpl* /usr/include/new_gdal/ || true && \
    mv /usr/include/new_gdal/ /usr/include/gdal/ || true

RUN apt-get update --allow-insecure-repositories -y && \
    apt-get install -y --allow-unauthenticated --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      libboost-dev \
      libeigen3-dev \
      libgeos-dev \
      libgtest-dev \
      libtbb-dev \
      libtinyxml2-dev \
      nlohmann-json3-dev \
      libopenblas-dev \
      liblapack-dev \
      libfftw3-dev \
      libjpeg-dev \
      libtiff-dev \
      libpng-dev \
      libpython3-dev \
      python3 \
      python3-pip \
      swig && \
    rm -rf /var/lib/apt/lists/*

# Build Fields2Cover and install into a portable prefix we can copy later.
RUN git clone https://github.com/Fields2Cover/Fields2Cover.git /workspaces/fields2cover && \
    mkdir -p /workspaces/fields2cover/build

WORKDIR /workspaces/fields2cover/build
RUN cmake -DBUILD_PYTHON=ON \
          -DBUILD_TUTORIALS=OFF \
          -DBUILD_TESTING=OFF \
          -DBUILD_DOC=OFF \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/opt/fields2cover-install .. && \
    make -j"$(nproc)" && \
    make install


############################
# Stage 1: Rocker R stack
############################
# R and FIELDimageR stack built on a versioned Rocker image.
FROM rocker/r-ver:4.3.1 AS r_stack

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspaces

RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    libcurl4-openssl-dev \
    libfftw3-dev \
    libgdal-dev \
    libgeos-dev \
    libgit2-dev \
    libglpk40 \
    libproj-dev \
    libsqlite3-dev \
    libssh2-1-dev \
    libssl-dev \
    libtiff-dev \
    libudunits2-dev \
    libx11-dev \
    libxml2-dev \
    make \
    g++ && \
    rm -rf /var/lib/apt/lists/*

# Keep stable CRAN installs in dedicated layers for Docker cache reuse.
RUN Rscript -e 'install.packages(c("BiocManager", "remotes", "leafsync", "git2r"), repos = "https://cloud.r-project.org", Ncpus = max(1, parallel::detectCores() - 1))'

# For R 4.3.x, allow BiocManager to resolve compatible Bioconductor version.
RUN Rscript -e 'BiocManager::install("EBImage", ask = FALSE, update = FALSE)'

RUN Rscript -e 'install.packages(c("attempt", "config", "DT", "doParallel", "Exact", "expm", "fields", "gld", "mvtnorm", "processx", "rstudioapi", "xml2", "BH"), repos = "https://cloud.r-project.org", Ncpus = max(1, parallel::detectCores() - 1), quiet = FALSE)'

RUN Rscript -e 'install.packages("exactextractr", repos = "https://cloud.r-project.org", Ncpus = max(1, parallel::detectCores() - 1), quiet = FALSE)'

# Install known FIELDimageR dependencies in a dedicated layer.
RUN Rscript -e 'install.packages(c("DescTools", "plyr"), repos = "https://cloud.r-project.org", Ncpus = max(1, parallel::detectCores() - 1), quiet = FALSE)'

# Keep GitHub package installs isolated so CRAN/Bioc layers remain cached.
RUN Rscript -e 'remotes::install_github("OpenDroneMap/FIELDimageR", dependencies = FALSE, upgrade = "never", quiet = FALSE)' && \
    Rscript -e 'library(FIELDimageR); cat("FIELDimageR installed successfully. Version:", as.character(utils::packageVersion("FIELDimageR")), "\n")'

RUN Rscript -e 'remotes::install_github("filipematias23/FIELDimageR.Extra", dependencies = FALSE, upgrade = "never", quiet = FALSE)' && \
    Rscript -e 'library(FIELDimageR.Extra); cat("FIELDimageR.Extra installed successfully. Version:", as.character(utils::packageVersion("FIELDimageR.Extra")), "\n")'


##########################################
# Stage 2: Final runtime (single container)
##########################################
# Final image is still one container; it combines:
# - Rocker R runtime + R packages (from r_stack)
# - Fields2Cover build artifacts (from fields2cover_builder)
# - Python backend app
FROM r_stack AS runtime

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-numpy \
    libopenblas-dev \
    liblapack-dev && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Bring Fields2Cover binaries/libs into final image.
COPY --from=fields2cover_builder /opt/fields2cover-install /opt/fields2cover-install
ENV PATH="/opt/fields2cover-install/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/fields2cover-install/lib:${LD_LIBRARY_PATH}"

# Build-time smoke checks (run during docker build, not at container startup).
# These fail fast if required R packages or Fields2Cover artifacts are missing.
RUN Rscript -e 'library(FIELDimageR); library(FIELDimageR.Extra); library(fields); library(exactextractr); cat("R package smoke check passed.\n")'
RUN bash -lc 'test -d /opt/fields2cover-install/lib && \
    test -d /opt/fields2cover-install/include && \
    test -n "$(ls -A /opt/fields2cover-install/lib 2>/dev/null)" && \
    echo "Fields2Cover artifact smoke check passed."'

# Install Python dependencies and backend source.
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app/

ENV PORT=8001 \
    HOST=0.0.0.0 \
    PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["sh", "-c", "uvicorn app.main:app --host ${HOST:-0.0.0.0} --port ${PORT:-8001}"]
