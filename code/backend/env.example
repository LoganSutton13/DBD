# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Supported file formats (comma-separated; MIME types for images)
SUPPORTED_FORMATS=image/jpeg,image/png,image/tiff,image/tif
# Allowed auxiliary file extensions (comma-separated; .nav, .obs, .bin, .MRK)
# ALLOWED_AUXILIARY_EXTENSIONS=.nav,.obs,.bin,.mrk

# Node ODM Configuration
NODEODM_URL=http://localhost:3000
NODEODM_TIMEOUT=3600

# App config JSON (upload_settings.json, rtk_base_config.json) is stored under UPLOAD_DIR.
